{
  "name": "hwmusic",
  "version": "0.0.2",
  "private": true,
  "type": "module",
  "description": "hwmusic · 非官方华为音乐终端播放器与原生客户端",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "start": "node native/scripts/start.mjs",
    "dev": "npm start",
    "build": "node native/scripts/build.mjs",
    "build:native": "npm run build",
    "build:native:mac": "node native/scripts/build-macos.mjs",
    "dist": "node native/scripts/package.mjs",
    "dist:linux": "node native/scripts/package.mjs linux",
    "dist:linux:deb": "node native/scripts/package.mjs linux x64 deb",
    "dist:mac:arm64": "node native/scripts/package.mjs mac arm64",
    "dist:mac:x64": "node native/scripts/package.mjs mac x64",
    "test": "cd native && go test ./... -count=1",
    "test:native": "npm test",
    "vet": "cd native && go vet ./...",
    "test:native:ui": "node native/scripts/check-ui.mjs",
    "test:native:package": "node native/scripts/check-package.mjs",
    "icons": "node native/scripts/make-icon.mjs && node native/scripts/generate-assets.mjs",
    "build:tui": "node native/scripts/build-terminal.mjs",
    "install:tui": "node native/scripts/build-terminal.mjs --install"
  },
  "devDependencies": {
    "playwright-core": "1.64.0"
  }
}
